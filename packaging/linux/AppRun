#!/bin/sh
# AppImage entry point. `DiskDiff.AppImage cli …` runs diskdiff-cli, the
# command-line tool for AI agents (`cli mcp` is its MCP server, which is what
# Help > Copy MCP setup puts in an MCP client's config); anything else starts
# the app.
HERE="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = "cli" ]; then
  shift
  exec "$HERE/usr/bin/diskdiff-cli" "$@"
fi
exec "$HERE/usr/bin/diskdiff" "$@"
